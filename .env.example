# --- Supabase (Postgres) ---
# Project Settings > Database > Connection string
# DATABASE_URL: "Transaction pooler" (puerto 6543) - usado por la app en Vercel
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"
# DIRECT_URL: conexion directa (puerto 5432) - usada solo por prisma db push / migrate
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require"

# --- Seguridad ---
# Acceso a la aplicacion (HTTP Basic Auth). OBLIGATORIO en produccion.
APP_AUTH_USER="preceptoria"
APP_AUTH_PASSWORD="CAMBIAR_POR_UNA_CLAVE_LARGA_Y_UNICA"
# Clave AES-256 para cifrar las firmas en la base (32 bytes en hex). Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Guardarla tambien en un gestor de contrasenas: si se pierde, las firmas no se pueden recuperar.
SIGNATURE_ENCRYPTION_KEY="CAMBIAR_POR_64_CARACTERES_HEX"

# URL publica de la app (usada en el QR de firma con celular)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="preceptor-ia"

